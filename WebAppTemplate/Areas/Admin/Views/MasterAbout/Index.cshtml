@model IEnumerable<WebAppTemplate.ViewModels.MasterAboutViewModel>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

@if (Model.Count() == 0)
{

    <div>
        <a asp-action="Create">Create</a>
    </div>
}

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ImageUrl)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CV_URL)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Desc)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Phone)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DateOfBirth)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Country)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Address)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.isActive)
            </th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                    <img src="~/MasterAboutImages/@item.ImageUrl" alt="Image" width="100" height="100" />
            </td>
            <td>
                    <a href="~/MasterAboutPDF/@item.CV_URL" download> <i class="fa fa-file-pdf"> </i> </a>
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Desc)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Phone)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DateOfBirth)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Country)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Address)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.isActive)
            </td>
            <td>  
                <a class="btn btn-warning" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                <a class="btn btn-primary" asp-action="Details" asp-route-id="@item.Id">Details</a>
                <a class="btn btn-danger" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    @if (item.isActive)
                    {
                        <a class="btn btn-light" asp-action="ActivationsStatus" asp-route-id="@item.Id">Deactivate</a>
                    }else
                    {
                        <a class="btn btn-light" asp-action="ActivationsStatus" asp-route-id="@item.Id">Activate</a>
                    }
            </td>
        </tr>
}
    </tbody>
</table>
