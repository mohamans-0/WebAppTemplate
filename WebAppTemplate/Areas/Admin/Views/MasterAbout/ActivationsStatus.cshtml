@model WebAppTemplate.ViewModels.MasterAboutViewModel

@{
    ViewData["Title"] = "ActivationsStatus";
}

<h1>ActivationsStatus</h1>

    @if (Model.isActive)
    {
        <h3>Are you sure you want to deactivate this?</h3>
    }
    else
    {
        <h3>Are you sure you want to activate this?</h3>
    }
<div>
    <h4>MasterAbout</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ImageUrl)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ImageUrl)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.CV_URL)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CV_URL)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Desc)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Desc)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Phone)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Phone)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.DateOfBirth)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DateOfBirth)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Country)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Country)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Address)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Address)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Email)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Email)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.isActive)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.isActive)
        </dd>
    </dl>
    
    <form asp-action="ActivationsStatus">
        <input type="hidden" asp-for="Id" />
        @if (Model.isActive)
        {
            <input type="submit" value="Deactivate" class="btn btn-danger" />
        }
        else
        {
            <input type="submit" value="Activate" class="btn btn-danger" />
        }
        <a asp-action="Index">Back to List</a>
    </form>
</div>
