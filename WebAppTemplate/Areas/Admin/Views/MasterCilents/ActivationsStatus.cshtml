@model WebAppTemplate.ViewModels.MasterCilentsViewModel

@{
    ViewData["Title"] = "ActivationsStatus";
}

<h1>ActivationsStatus</h1>

@if (Model.isActive)
{
    <h3>Are you sure you want to deactivate this?</h3>
}
else
{
    <h3>Are you sure you want to activate this?</h3>
}
<div>
    <h4>MasterCilents</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.imageURL)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.imageURL)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.URL)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.URL)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.isActive)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.isActive)
        </dd>
    </dl>
    
    <form asp-action="ActivationsStatus">
        <input type="hidden" asp-for="Id" />
        @if (Model.isActive)
        {
            <input type="submit" value="Deactivate" class="btn btn-danger" />
        }
        else
        {
            <input type="submit" value="Activate" class="btn btn-danger" />
        }
        <a class="btn btn-danger" asp-action="Index">Back to List</a>
    </form>
</div>
