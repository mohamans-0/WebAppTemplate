@using WebAppTemplate.Extensions
@model WebAppTemplate.ViewModels.HomeViewModel


@{
    ViewData["Title"] = "Home Page";
}

<div class="page-content">

    <header id="site_header" class="header mobile-menu-hide">
        <div class="header-content">
            <div class="header-photo">
                <img src="~/MasterAboutImages/@Model.MasterAboutViewModel.ImageUrl" alt="@Model.MasterAboutViewModel.Name">
            </div>
            <div class="header-titles">
                <h2>@Model.MasterAboutViewModel.Name</h2>
                <h4>@Model.MasterPositions.Where(x=>x.isPrimary).FirstOrDefault().Name</h4>
            </div>
        </div>

        <ul class="main-menu">
            <li class="active">
                <a href="#home" class="nav-anim">
                    <span class="menu-icon lnr lnr-home"></span>
                    <span class="link-text">Home</span>
                </a>
            </li>
            <li>
                <a href="#about-me" class="nav-anim">
                    <span class="menu-icon lnr lnr-user"></span>
                    <span class="link-text">About Me</span>
                </a>
            </li>
            <li>
                <a href="#resume" class="nav-anim">
                    <span class="menu-icon lnr lnr-graduation-hat"></span>
                    <span class="link-text">Resume</span>
                </a>
            </li>
            <li>
                <a href="#portfolio" class="nav-anim">
                    <span class="menu-icon lnr lnr-briefcase"></span>
                    <span class="link-text">Portfolio</span>
                </a>
            </li>
            <li>
                <a href="#contact" class="nav-anim">
                    <span class="menu-icon lnr lnr-envelope"></span>
                    <span class="link-text">Contact</span>
                </a>
            </li>
        </ul>

        <div class="social-links">
            <ul>

                @* @foreach (var item in Model.MasterSocialMedia.Where(v=>v.isSocialMedia==true).FirstOrDefault())
                {
                    <li>
                        <a href="@item.Url" target="_blank">
                            <i class="@item.Icon">

                            </i>
                        </a>
                    </li>
                } *@

                <li>
                    <a href="@Model.MasterSocialMedia.Where(x => x.isSocialMedia == true && x.Keyword == "facebook").FirstOrDefault().Url" target="_blank">
                        <i class="@Model.MasterSocialMedia.Where(x => x.isSocialMedia == true && x.Keyword == "facebook").FirstOrDefault().Icon">
                        </i>
                    </a>
                </li>
                <li>
                    <a href="@Model.MasterSocialMedia.Where(x => x.isSocialMedia == true && x.Keyword == "linkedin").FirstOrDefault().Url" target="_blank">
                        <i class="@Model.MasterSocialMedia.Where(x => x.isSocialMedia == true && x.Keyword == "linkedin").FirstOrDefault().Icon">
                        </i>
                    </a>
                </li>
                <li>
                    <a href="@Model.MasterSocialMedia.Where(x => x.isSocialMedia == true && x.Keyword == "whatsapp").FirstOrDefault().Url" target="_blank">
                        <i class="@Model.MasterSocialMedia.Where(x => x.isSocialMedia == true && x.Keyword == "whatsapp").FirstOrDefault().Icon">
                        </i>
                    </a>
                </li>

            </ul>
        </div>

        <div class="header-buttons">
            <a href="~/MasterAboutPDF/@Model.MasterAboutViewModel.CV_URL" download target="_blank" class="btn btn-primary">Download CV</a>
        </div>

        @* <div class="copyrights">© 2020 All rights reserved.</div> *@
    </header>


    <!-- Mobile Navigation -->
    <div class="menu-toggle">
        <span></span>
        <span></span>
        <span></span>
    </div>
    <!-- End Mobile Navigation -->

    <!-- Arrows Nav -->
    <div class="lmpixels-arrows-nav">
        <div class="lmpixels-arrow-right"><i class="lnr lnr-chevron-right"></i></div>
        <div class="lmpixels-arrow-left"><i class="lnr lnr-chevron-left"></i></div>
    </div>
    <!-- End Arrows Nav -->

    <div class="content-area">
        <div class="animated-sections">
            <!-- Home Subpage -->
            <section data-id="home" class="animated-section start-page">
                <div class="section-content vcentered">
                    <div class="row">
                        <div class="col-sm-12 col-md-12 col-lg-12">
                            <div class="title-block">
                                <h2>@Model.MasterAboutViewModel.Name</h2>
                                <div class="owl-carousel text-rotation">
                                    @foreach (var position in Model.MasterPositions)
                                    {
                                        <div class="item">
                                            <div class="sp-subtitle">@position.Name</div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
            <!-- End of Home Subpage -->

            <!-- About Me Subpage -->
            <section data-id="about-me" class="animated-section">
                <div class="page-title">
                    <h2>@Html.Raw(@Model.MasterTitles.Where(x => x.keyword == "AboutMe").FirstOrDefault().Title)</h2>
                </div>

                <div class="section-content">
                    <!-- Personal Information -->
                    <div class="row">
                        <div class="col-xs-12 col-sm-7">
                            <p>Proin volutpat mauris ac pellentesque pharetra. Suspendisse congue elit vel odio suscipit, sit amet tempor nisl imperdiet. Quisque ex justo, faucibus ut mi in, condimentum finibus dolor. Aliquam vitae hendrerit dolor, eget imperdiet mauris. Maecenas et ante id ipsum condimentum dictum et vel massa. Ut in imperdiet dolor, vel consectetur dui.</p>
                        </div>

                        <div class="col-xs-12 col-sm-5">
                            <div class="info-list">
                                <ul>
                                    <li>
                                        <span class="title">Age</span>
                                        <span class="value">@Model.MasterAboutViewModel.DateOfBirth.ToAge()</span>
                                    </li>

                                    <li>
                                        <span class="title">Residence</span>
                                        <span class="value">@Model.MasterAboutViewModel.Country</span>
                                    </li>

                                    <li>
                                        <span class="title">Address</span>
                                        <span class="value">@Model.MasterAboutViewModel.Address</span>
                                    </li>

                                    <li>
                                        <span class="title">e-mail</span>
                                        <span class="value">@Model.MasterAboutViewModel.Email</span>
                                    </li>

                                    <li>
                                        <span class="title">Phone</span>
                                        <span class="value">@Model.MasterAboutViewModel.Phone</span>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <!-- End of Personal Information -->

                    <div class="white-space-50"></div>

                    <!-- Services -->
                    <div class="row">
                        <div class="col-xs-12 col-sm-12">
                            <div class="block-title">
                                <h3>@Html.Raw(@Model.MasterTitles.Where(x => x.keyword == "WhatIDo").FirstOrDefault().Title)</h3>
                            </div>
                        </div>
                    </div>
                                        
                    <div class="row">
