                                            <i class="@Model.MasterWhatIDo.Where(b => b.Title == "House").FirstOrDefault().Icon"></i>
                                        </div>
                                        <div class="ci-text">
                                            <h4>@Model.MasterWhatIDo.Where(b => b.Title == "House").FirstOrDefault().Title</h4>
                                            <p>@Model.MasterWhatIDo.Where(b => b.Title == "House").FirstOrDefault().Desc</p>
