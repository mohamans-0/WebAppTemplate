                                            <i class="@Model.MasterWhatIDo.Where(b => b.Title == "Calendar").FirstOrDefault().Icon"></i>
                                        </div>
                                        <div class="ci-text">
                                            <h4>@Model.MasterWhatIDo.Where(b => b.Title == "Calendar").FirstOrDefault().Title</h4>
